{
  "name": "angel",
  "version": "1.1.0",
  "type": "module",
  "description": "AI agent that connects to Discord, Slack, iMessage, and Signal with tool use, memory, and coding agents",
  "bin": {
    "angel": "src/index.ts"
  },
  "files": [
    "src",
    "angel.config.example.yaml",
    "README.md",
    "SOUL.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "chatbot",
    "discord",
    "slack",
    "imessage",
    "signal",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IzonIcy/Angel"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts start",
    "setup": "bun run src/index.ts setup",
    "doctor": "bun run src/index.ts doctor",
    "smoke": "bun run src/index.ts smoke",
    "config": "bun run src/index.ts config",
    "reset": "bun run src/index.ts reset",
    "dev": "bun --watch run src/index.ts start",
    "prepare": "husky",
    "lint": "bunx biome check src",
    "typecheck": "tsc --noEmit",
    "fix": "bunx biome check --fix src",
    "format": "bunx biome format --write src",
    "build": "bun build src/index.ts --target bun --compile --outfile angel",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@clack/core": "^1.4.0",
    "@clack/prompts": "^1.5.0",
    "@slack/bolt": "^4.7.3",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.4",
    "openai": "^5.23.2",
    "picocolors": "^1.1.1",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "husky": "^9.1.7"
  }
}
